# ─── MongoDB ───
MONGO_URI="mongodb+srv://doadmin:CHANGE_ME@mongodb-49-hub-staging-backup-ccc0e078.mongo.ondigitalocean.com/49?replicaSet=mongodb-49-hub-staging-backup&tls=true&authSource=admin"

# ─── التخزين ───
RCLONE_CONFIG="/home/qutuz/.config/rclone/rclone.conf"
REMOTE="dospace:qutuz-db-backups/mongo"
BACKUP_DIR="/var/backups/mongo"

# ─── سياسة الاحتفاظ ───
RETENTION_DAYS=30
LOCAL_RETENTION_DAYS=3
LINK_EXPIRE="24h"

# ─── حدود التشغيل ───
DUMP_TIMEOUT_MS=900000
UPLOAD_TIMEOUT_MS=600000
MIN_BACKUP_SIZE_MB=1
MIN_FREE_DISK_MB=500

# ─── Brevo ───
# قائمة المستلمين ليست هنا — انسخ recipients.example.txt إلى recipients.txt وعبّئها.
BREVO_API_KEY="xkeysib-CHANGE_ME"
MAIL_FROM="backup@yourdomain.com"
MAIL_FROM_NAME="Backup Bot"

# ─── اختياري ───
HEALTHCHECK_URL=""
NOTIFY_ON_SUCCESS=true
TZ_DISPLAY="Africa/Cairo"
